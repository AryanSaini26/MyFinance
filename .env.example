# Local-only database credentials: replace before use outside your machine.
DATABASE_URL=postgres://myfinance:replace_with_local_database_password@localhost:5432/myfinance?sslmode=disable
POSTGRES_USER=myfinance
POSTGRES_PASSWORD=replace_with_local_database_password
POSTGRES_DB=myfinance
APP_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
# Generate two independent keys: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=replace_with_64_hex_characters
SYNC_SERVICE_SECRET=replace_with_a_random_secret_at_least_32_characters
SYNC_SERVICE_URL=http://localhost:8080
# mock is a deterministic simulator, sandbox calls Plaid's Sandbox only.
PLAID_MODE=mock
PLAID_ENV=sandbox
PLAID_CLIENT_ID=replace_with_sandbox_client_id
PLAID_SECRET=replace_with_sandbox_secret

# Optional live Sandbox smoke test: separate disposable database, name ending _test.
# TEST_DATABASE_URL=postgres://myfinance:replace_with_local_database_password@localhost:5432/myfinance_test?sslmode=disable
