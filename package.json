{
  "name": "myfinance-v2",
  "version": "2.0.0",
  "private": true,
  "workspaces": [
    "apps/web"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run dev -w apps/web",
    "build": "npm run build -w apps/web",
    "start": "npm run start -w apps/web",
    "typecheck": "tsc --noEmit -p apps/web/tsconfig.json",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "db:migrate": "node --import tsx scripts/migrate.ts",
    "model:train": "node --import tsx scripts/train.ts",
    "test:e2e": "playwright test",
    "format": "prettier --write apps/web/src apps/web/next.config.ts packages/classifier/*.ts scripts tests *.ts *.json .github/workflows/*.yml compose*.yaml",
    "format:check": "prettier --check apps/web/src apps/web/next.config.ts packages/classifier/*.ts scripts tests *.ts *.json .github/workflows/*.yml compose*.yaml",
    "env:init": "node scripts/env-init.mjs",
    "test:docker": "node scripts/test-docker.mjs",
    "check:node": "node scripts/check-node.mjs",
    "test:sandbox": "node --import tsx scripts/sandbox-smoke.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "prettier": "^3.9.10",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  },
  "type": "module"
}
